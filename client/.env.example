# Copy to .env.local and fill in. Never commit .env.local.

# Where the API (the server folder) lives. Locally: http://localhost:4000. On Vercel: your Render URL (https://....onrender.com)
API_URL=http://localhost:4000

# Must be identical to REVALIDATE_SECRET in the API's .env. Any long random string.
REVALIDATE_SECRET=

# The public address of this site (used for SEO). Locally: http://localhost:3000. On Vercel: your live URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
