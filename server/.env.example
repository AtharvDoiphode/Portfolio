# Copy this file to .env and fill it in. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=4000

# --- MongoDB Atlas (Database > Connect > Drivers > copy the connection string) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/portfolio?retryWrites=true&w=majority

# --- Admin login (one admin: you) ---
# Make the hash with:  npm run hash-password
ADMIN_EMAIL=doiphodeatharva750@gmail.com
ADMIN_PASSWORD_HASH=
# Any long random string, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Frontend (used for CORS and to refresh the site after you edit) ---
FRONTEND_URL=http://localhost:3000
# Same value must be set on the frontend (Vercel). Any long random string.
REVALIDATE_SECRET=

# --- Cloudinary (Dashboard > Settings > API Keys) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (contact form emails). Leave empty to only store messages in the inbox. ---
RESEND_API_KEY=
# Where new messages are emailed to (defaults to ADMIN_EMAIL)
CONTACT_TO_EMAIL=
MAIL_FROM=Portfolio <onboarding@resend.dev>
